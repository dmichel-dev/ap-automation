# Copy to .env and fill in. Never commit .env.
# Generate random values with:  openssl rand -hex 32

TZ=Europe/Paris

# --- PostgreSQL --------------------------------------------------------------
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=change-me

# n8n's own database (n8n internal tables live in its public schema)
N8N_DB_NAME=n8n
N8N_DB_USER=n8n
N8N_DB_PASSWORD=change-me

# Application role: owns the "ap" schema only (invoices, lines, review queue, log)
AP_DB_USER=ap_app
AP_DB_PASSWORD=change-me

# --- n8n ---------------------------------------------------------------------
# Encrypts stored n8n credentials. Keep it stable: losing it makes them unreadable.
N8N_ENCRYPTION_KEY=change-me

# --- Core service (FastAPI) --------------------------------------------------
# Bearer token n8n sends to the core service (stored in n8n as a Header Auth credential)
CORE_API_TOKEN=change-me

MISTRAL_API_KEY=
MISTRAL_OCR_MODEL=mistral-ocr-latest

# Invoices scoring below this go to human review (0-1)
CONFIDENCE_THRESHOLD=0.85
# Review page confidence badge: green from this score; orange between the threshold above and this (display only)
REVIEW_CONFIDENCE_HIGH=0.95
# Company accounting policy, in the home currency (docs/validation.md)
# Cut-off: a service period ending in an earlier month goes to review at or above this amount
CUTOFF_MATERIALITY=1000
# Capitalisation policy: an item costing at least this may be a fixed asset → review
CAPEX_THRESHOLD=2500
HOME_CURRENCY=USD
# INTAKE_EMAIL_ALIAS=invoices@davidmichel.dev   # only emails to this address are processed

# Original files are deleted once attached to the QuickBooks bill, or after this many
# days at the latest (privacy, especially for the public demo)
FILE_RETENTION_DAYS=30

# --- Review page ---------------------------------------------------------------
# The internal listener is configured in docker-compose.yml (loopback only, every role).
# Accounts are created with the CLI, see docs/security.md:
#   docker compose exec review-web python -m app.web.users add --email … --name … --role reviewer --scope live

# --- Accounting + matching. Defaults suit the QuickBooks sandbox demo company -----
QBO_REALM_ID=                      # QuickBooks company ID (shown in the sandbox company settings)
# QBO_API_HOST=https://sandbox-quickbooks.api.intuit.com   # production: https://quickbooks.api.intuit.com
# Liability for taxes withheld at source (e.g. Spanish IRPF); created once in QuickBooks (docs/integrations.md)
QBO_WITHHOLDING_ACCOUNT_ID=
# Receivable for recoverable taxes; only needed if app/tax_treatment.json marks a tax "recoverable"
# QBO_TAX_RECOVERABLE_ACCOUNT_ID=
# Another tax treatment policy file (default: services/core/app/tax_treatment.json)
# TAX_TREATMENT_FILE=
# QBO_BANK_ACCOUNT_ID=35           # Checking (the account the Plaid transactions belong to)
# MATCH_AMOUNT_ABS_TOLERANCE=1.00  # the smaller of the two tolerances applies
# MATCH_AMOUNT_PCT_TOLERANCE=0.005
# MATCH_DAYS_BEFORE_INVOICE=3
# MATCH_DAYS_AFTER_DUE=30
# MATCH_NAME_MIN_SIMILARITY=0.6

# --- Plaid: sandbox keys from dashboard.plaid.com ---------------------------
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
# Written by scripts/plaid_sandbox.py setup (never commit the real values)
PLAID_ACCESS_TOKEN=
PLAID_ACCOUNT_ID=
