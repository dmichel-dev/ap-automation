        "errorMessage": "={{ 'demo upload ' + $('Upload ID').item.json.upload_id + ': the core answered ' + ($json.statusCode ?? 'nothing') + ' ' + JSON.stringify($json.body?.detail ?? $json.error?.message ?? '') }}"
      },
      "position": [
        0,
