{
  "active": false,
  "connections": {
    "Daily summary (core)": {
      "main": [
        [
          {
            "index": 0,
            "node": "Summary ready?",
            "type": "main"
          }
        ]
      ]
    },
    "Every day at 08:00": {
      "main": [
        [
          {
            "index": 0,
            "node": "Daily summary (core)",
            "type": "main"
          }
        ]
      ]
    },
    "Manual run": {
      "main": [
        [
          {
            "index": 0,
            "node": "Daily summary (core)",
            "type": "main"
          }
        ]
      ]
    },
    "Send summary email": {
      "main": [
        [
          {
            "index": 0,
            "node": "Log summary sent",
            "type": "main"
          }
        ]
      ]
    },
    "Summary ready?": {
      "main": [
        [
          {
            "index": 0,
            "node": "Send summary email",
            "type": "main"
          }
        ],
        [
          {
            "index": 0,
            "node": "Stop: no summary",
            "type": "main"
          }
        ]
      ]
    }
  },
  "name": "AP – Daily summary",
  "nodes": [
    {
      "id": "note-daily-summary",
      "name": "Note: Daily summary",
      "parameters": {
        "color": 5,
        "content": "## Daily summary\nOne email every morning about the **last 24 hours**: invoices received and posted, touchless rate, payments and write-offs, open review items (oldest first), fraud alerts, bank details seen for the first time, email intake problems.\n\nThe **core** computes every figure and writes the email; this workflow only starts it and sends it. Live data only; bank details masked.",
        "height": 350,
        "width": 1380
      },
      "position": [
        -40,
        -150
      ],
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1
    },
    {
      "id": "note-build",
      "name": "Note: Build",
      "parameters": {
        "color": 7,
        "content": "## Build\nEvery day at 08:00 (Paris time), or by hand. The core answers with the recipients, subject and text.",
        "height": 550,
        "width": 660
      },
      "position": [
        -40,
        250
      ],
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1
    },
    {
      "id": "note-send",
      "name": "Note: Send",
      "parameters": {
        "color": 7,
        "content": "## Send\nGmail sends it to the configured recipients (DAILY_SUMMARY_TO), then the AP log records it.",
        "height": 350,
        "width": 420
      },
      "position": [
        680,
        250
      ],
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1
    },
    {
      "id": "note-not-built",
      "name": "Note: Not built",
      "parameters": {
        "color": 3,
        "content": "## Not built\nThe core did not answer: the run fails, so the error workflow logs it.",
        "height": 350,
        "width": 420
      },
      "position": [
        680,
        650
      ],
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1
    },
    {
      "id": "every-day-at-0800",
      "name": "Every day at 08:00",
      "parameters": {
        "rule": {
          "interval": [
            {
              "daysInterval": 1,
              "field": "days",
              "triggerAtHour": 8
            }
          ]
        }
      },
      "position": [
        0,
        400
      ],
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2
    },
    {
      "id": "manual-run",
      "name": "Manual run",
      "parameters": {},
      "position": [
        0,
        600
      ],
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1
    },
    {
      "credentials": {
        "httpHeaderAuth": {
          "name": "AP core token"
        }
      },
      "id": "daily-summary-core",
      "maxTries": 3,
      "name": "Daily summary (core)",
      "onError": "continueRegularOutput",
      "parameters": {
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "method": "GET",
        "options": {
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          }
        },
        "url": "http://core:8000/summary/daily"
      },
      "position": [
        240,
        400
      ],
      "retryOnFail": true,
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "waitBetweenTries": 2000
    },
    {
      "id": "summary-ready",
      "name": "Summary ready?",
      "parameters": {
        "conditions": {
          "combinator": "and",
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.statusCode === 200 }}",
              "operator": {
                "operation": "true",
                "singleValue": true,
                "type": "boolean"
              },
              "rightValue": ""
            }
          ],
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          }
        },
        "options": {}
      },
      "position": [
        480,
        400
      ],
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2
    },
    {
      "credentials": {
        "gmailOAuth2": {
          "name": "Gmail – david@davidmichel.dev"
        }
      },
      "id": "send-summary-email",
      "name": "Send summary email",
      "parameters": {
        "emailType": "html",
        "message": "={{ $('Daily summary (core)').first().json.body.html }}",
        "operation": "send",
        "options": {
          "appendAttribution": false
        },
        "resource": "message",
        "sendTo": "={{ $('Daily summary (core)').first().json.body.to }}",
        "subject": "={{ $('Daily summary (core)').first().json.body.subject }}"
      },
      "position": [
        720,
        400
      ],
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1
    },
    {
      "credentials": {
        "postgres": {
          "name": "AP database (ap_app)"
        }
      },
      "id": "log-summary-sent",
      "name": "Log summary sent",
      "parameters": {
        "operation": "executeQuery",
        "options": {
          "queryReplacement": "={{ [$execution.id, JSON.stringify({ subject: $('Daily summary (core)').first().json.body.subject })] }}"
        },
        "query": "INSERT INTO ap.processing_log (channel, n8n_execution_id, step, level, message, details)\nVALUES ('system', $1, 'daily_summary', 'info', 'daily summary sent', $2::jsonb)"
      },
      "position": [
        960,
        400
      ],
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6
    },
    {
      "id": "stop-no-summary",
      "name": "Stop: no summary",
      "parameters": {
        "errorMessage": "={{ 'daily summary not built: HTTP ' + ($json.statusCode ?? 0) + ' ' + ($json.body?.detail ?? '') }}"
      },
      "position": [
        720,
        800
      ],
      "type": "n8n-nodes-base.stopAndError",
      "typeVersion": 1
    }
  ],
  "pinData": {},
  "settings": {
    "errorWorkflow": "apErrorLog000001",
    "executionOrder": "v1",
    "saveDataErrorExecution": "all",
    "saveDataSuccessExecution": "all",
    "saveManualExecutions": true,
    "timezone": "Europe/Paris"
  }
}
