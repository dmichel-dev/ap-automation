      "id": "process-invoice-core",
      "name": "Process invoice (core)",
      "onError": "continueErrorOutput",
      "parameters": {
        "authentication": "genericCredentialType",
        "bodyParameters": {
          "parameters": [
            {
              "inputDataFieldName": "file",
