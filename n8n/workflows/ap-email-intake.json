    {
      "id": "email-facts",
      "name": "Email facts",
      "parameters": {
        "jsCode": "// For the core's screening: metadata (recipients, attachment types, names, sizes) and the text\n// (subject + body, which the core checks for bank-change wording and never stores; it accepts\n// up to 20,000 characters).\nreturn $('Email in').all().map((email, i) => {\n  const mail = email.json;\n  const files = Object.entries(email.binary ?? {}).filter(([key]) => /^attachment_\\d+$/.test(key));\n  return { json: {\n    message_id: mail.id,\n    thread_id: mail.threadId,\n    recipients: [...(mail.to?.value ?? []), ...(mail.cc?.value ?? [])].map(a => String(a.address ?? '')),\n    delivered_to: String(mail.headers?.['delivered-to'] ?? ''),\n    attachments: files.map(([key, b]) => ({ key, mime_type: b.mimeType ?? null, file_name: b.fileName ?? null,\n                                           size: b.fileSize ?? null })),\n    text: [mail.subject, mail.text].filter(Boolean).join('\\n\\n').slice(0, 20000),\n  }, pairedItem: { item: i } };\n});",
        "language": "javaScript",
        "mode": "runOnceForAllItems"
      },
      "position": [
        720,
        400
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    },
    {
      "credentials": {
        "httpHeaderAuth": {
          "name": "AP core token"
        }
      },
      "id": "screen-email-core",
      "maxTries": 3,
      "name": "Screen email (core)",
      "onError": "continueRegularOutput",
      "parameters": {
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "jsonBody": "={{ JSON.stringify({ recipients: $json.recipients, delivered_to: $json.delivered_to, attachments: $json.attachments, text: $json.text, message_id: $json.message_id, execution_id: $execution.id }) }}",
        "method": "POST",
        "options": {
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          }
        },
        "sendBody": true,
        "specifyBody": "json",
        "url": "=http://core:8000/intake/email/screen"
      },
      "position": [
        960,
        400
      ],
      "retryOnFail": true,
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "waitBetweenTries": 2000
    },
    {
      "id": "split-by-attachment",
      "name": "Split by attachment",
      "parameters": {
        "jsCode": "// One item per attachment the core accepted (with its file), or one item saying why there is none.\n// File names are not passed on to the logs: they may be personal data.\nconst LABELS = { processed: 'AP/Processed', ready: 'AP/Ready', review: 'AP/Review',\n                 rejected: 'AP/Rejected', error: 'AP/Error', fraud: 'AP/Fraud alert' };\n\n// Label IDs, looked up by name so nothing is hard-coded\nconst byName = Object.fromEntries($('Get AP labels').all().map(i => [i.json.name, i.json.id]));\nconst labels = {};\nfor (const [key, name] of Object.entries(LABELS)) {\n  if (!byName[name]) throw new Error(`Gmail label \"${name}\" not found: create it in Gmail first`);\n  labels[key] = byName[name];\n}\n\nconst emails = $('Email facts').all();\nconst files = $('Email in').all();\nconst out = [];\n$input.all().forEach((screen, i) => {\n  const mail = emails[i].json, s = screen.json.body;\n  const base = { message_id: mail.message_id, thread_id: mail.thread_id, labels };\n  if (screen.json.statusCode !== 200) {  // the screening itself failed: what was seen, for the core\n    out.push({ json: { ...base, route: 'error', stage: 'screen', source_ref: `gmail:${mail.message_id}`,\n                       status_code: screen.json.statusCode ?? null, error: s?.error ?? null,\n                       message: String(s?.message ?? screen.json.error?.message ?? '').slice(0, 300) },\n               pairedItem: { item: i } });\n    return;\n  }\n  if (s.route !== 'process') {\n    out.push({ json: { ...base, route: s.route, reason: s.reason,\n                       details: { attachments: s.attachments, skipped: s.skipped } }, pairedItem: { item: i } });\n    return;\n  }\n  for (const a of s.accepted) {\n    out.push({\n      json: { ...base, route: 'process', source_ref: `gmail:${mail.message_id}:${a.index}`, mime: a.mime,\n              size: a.size, attachments_in_email: s.accepted.length, email_text: mail.text },\n      binary: { file: files[i].binary[a.key] },\n      pairedItem: { item: i },\n    });\n  }\n});\nreturn out;",
        "language": "javaScript",
        "mode": "runOnceForAllItems"
      },
      "position": [
        1200,
        400
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    },
