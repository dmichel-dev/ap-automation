      "id": "files-to-screen",
      "name": "Files to screen",
      "parameters": {
        "jsCode": "// The Inbox files' metadata for the core (never their content). Drive sends sizes as strings.\nconst r = $input.first().json;\nif (r.statusCode !== 200) throw new Error(`Drive Inbox listing: HTTP ${r.statusCode ?? 'no answer'}`);\nconst files = (r.body.files ?? []).map(f => ({ id: f.id, name: f.name ?? null, mime_type: f.mimeType ?? null,\n                                               size: f.size ?? null }));\nreturn [{ json: { files } }];",
        "language": "javaScript",
        "mode": "runOnceForAllItems"
      },
      "position": [
        1200,
        400
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
