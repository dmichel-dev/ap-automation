    {
      "id": "split-by-file",
      "name": "Split by file",
      "parameters": {
        "jsCode": "// One item per file the core sends somewhere now: 'process' or 'error'. Files it says to 'wait'\n// (being processed by another run, retry not due yet, over this run's limit) stay in Inbox.\nconst screen = $input.first().json;\nif (screen.statusCode !== 200) {\n  throw new Error(`Drive screening: the core answered ${screen.statusCode ?? 'nothing'}; the next run tries again`);\n}\nconst folders = $('Folder plan').first().json;\nreturn screen.body.files\n  .filter(f => f.route !== 'wait')\n  .map(f => ({ json: { id: f.id, route: f.route, reason: f.reason, source_ref: `drive:${f.id}`,\n                       folders: { processed: folders.processed, error: folders.error } } }));",
        "language": "javaScript",
        "mode": "runOnceForAllItems"
      },
      "position": [
        1680,
        400
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
