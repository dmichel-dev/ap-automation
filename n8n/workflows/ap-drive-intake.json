    {
      "credentials": {
        "googleDriveOAuth2Api": {
          "name": "Google Drive – david@davidmichel.dev"
        }
      },
      "executeOnce": true,
      "id": "find-ap-folders",
      "maxTries": 3,
      "name": "Find AP folders",
      "onError": "continueRegularOutput",
      "parameters": {
        "authentication": "predefinedCredentialType",
        "method": "GET",
        "nodeCredentialType": "googleDriveOAuth2Api",
        "options": {
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          }
        },
        "queryParameters": {
          "parameters": [
            {
              "name": "q",
              "value": "mimeType = 'application/vnd.google-apps.folder' and trashed = false and ((name = 'AP Automation' and 'root' in parents) or name = 'Inbox' or name = 'Processed' or name = 'Error')"
            },
            {
              "name": "fields",
              "value": "files(id,name,parents)"
            },
            {
              "name": "orderBy",
              "value": "createdTime"
            },
            {
              "name": "pageSize",
              "value": "100"
            }
          ]
        },
        "sendQuery": true,
        "url": "https://www.googleapis.com/drive/v3/files"
      },
      "position": [
        240,
        400
      ],
      "retryOnFail": true,
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "waitBetweenTries": 2000
    },
    {
      "id": "folder-plan",
      "name": "Folder plan",
      "parameters": {
        "jsCode": "// The AP folders' IDs (the oldest of each name, if there are several), and the ones still missing.\n// A subfolder can only be created once its parent exists: a new 'AP Automation' gets its subfolders\n// on the next run.\nconst r = $input.first().json;\nif (r.statusCode !== 200) throw new Error(`Drive folder search: HTTP ${r.statusCode ?? 'no answer'}`);\nconst folders = r.body.files ?? [];\nconst root = folders.find(f => f.name === 'AP Automation');\nconst inRoot = name => root && folders.find(f => f.name === name && (f.parents ?? []).includes(root.id));\nconst ids = { root: root?.id ?? null, inbox: inRoot('Inbox')?.id ?? null,\n              processed: inRoot('Processed')?.id ?? null, error: inRoot('Error')?.id ?? null };\nconst missing = !root ? [{ name: 'AP Automation', parent: 'root' }]\n  : [['inbox', 'Inbox'], ['processed', 'Processed'], ['error', 'Error']]\n      .filter(([key]) => !ids[key]).map(([, name]) => ({ name, parent: root.id }));\nreturn [{ json: { ...ids, missing } }];",
        "language": "javaScript",
        "mode": "runOnceForAllItems"
      },
      "position": [
        480,
        400
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    },
    {
      "id": "folders-ready",
      "name": "Folders ready?",
      "parameters": {
        "conditions": {
          "combinator": "and",
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.missing.length === 0 }}",
              "operator": {
                "operation": "true",
                "singleValue": true,
                "type": "boolean"
              },
              "rightValue": ""
            }
          ],
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          }
        },
        "options": {}
      },
      "position": [
        720,
        400
      ],
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2
    },
