  "name": "AP – Sync QuickBooks reference data",
  "nodes": [
    {
      "id": "every-hour",
      "name": "Every hour",
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 1
            }
          ]
        }
      },
      "position": [
        0,
        200
      ],
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2
    },
    {
      "id": "manual-run",
      "name": "Manual run",
      "parameters": {},
