      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1
    },
    {
      "credentials": {
        "httpHeaderAuth": {
          "name": "AP core token"
        }
      },
      "executeOnce": true,
      "id": "quickbooks-target-core",
      "maxTries": 3,
      "name": "QuickBooks target (core)",
      "onError": "continueRegularOutput",
      "parameters": {
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "method": "GET",
        "options": {
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          }
        },
        "url": "http://core:8000/accounting/target"
      },
      "position": [
        240,
        300
      ],
      "retryOnFail": true,
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "waitBetweenTries": 2000
    },
    {
      "credentials": {
        "quickBooksOAuth2Api": {
          "name": "QuickBooks – Sandbox US"
        }
      },
      "id": "accounts-qbo",
      "maxTries": 3,
      "name": "Accounts (QBO)",
      "onError": "continueRegularOutput",
      "parameters": {
        "authentication": "predefinedCredentialType",
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/json"
            }
          ]
        },
        "method": "GET",
        "nodeCredentialType": "quickBooksOAuth2Api",
        "options": {
          "batching": {
            "batch": {
              "batchInterval": 300,
              "batchSize": 1
            }
          },
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          }
        },
        "queryParameters": {
          "parameters": [
            {
              "name": "minorversion",
              "value": "={{ $('QuickBooks target (core)').first().json.body.minorversion }}"
            },
            {
              "name": "query",
              "value": "select * from Account maxresults 1000"
            }
          ]
        },
        "sendHeaders": true,
        "sendQuery": true,
        "url": "={{ $('QuickBooks target (core)').first().json.body.qbo_base }}/query"
      },
      "position": [
        460,
        300
      ],
      "retryOnFail": true,
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "waitBetweenTries": 2000
    },
    {
