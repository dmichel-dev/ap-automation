  "name": "AP – Sync QuickBooks reference data",
  "nodes": [
    {
      "id": "note-sync-quickbooks-reference-data",
      "name": "Note: Sync QuickBooks reference data",
      "parameters": {
        "color": 5,
        "content": "## Sync QuickBooks reference data\nKeeps a copy of the QuickBooks **chart of accounts** and **vendor list** in the AP database.\n\n- The review page's account picker reads the accounts.\n- The vendors tell the core which suppliers are already known.\n\nQuickBooks tokens stay in n8n. The core checks every answer and keeps its previous copy if an answer is unusable.",
        "height": 350,
        "width": 1380
      },
      "position": [
        -40,
        -150
      ],
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1
    },
    {
      "id": "note-start",
      "name": "Note: Start",
      "parameters": {
        "color": 7,
        "content": "## Start\nEvery hour, or by hand after changing accounts in QuickBooks. The core says which company to call.",
        "height": 550,
        "width": 420
      },
      "position": [
        -40,
        250
      ],
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1
    },
    {
      "id": "note-chart-of-accounts",
      "name": "Note: Chart of accounts",
      "parameters": {
        "color": 7,
        "content": "## Chart of accounts\nRead all accounts, then store them in the core. A refused answer stops the run.",
        "height": 550,
        "width": 660
      },
      "position": [
        440,
        250
      ],
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1
    },
    {
      "id": "note-vendor-list",
      "name": "Note: Vendor list",
      "parameters": {
        "color": 7,
        "content": "## Vendor list\nRead all vendors, then store them in the core. A refused answer stops the run.",
        "height": 550,
        "width": 660
      },
      "position": [
        1160,
        250
      ],
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1
    },
    {
      "id": "every-hour",
      "name": "Every hour",
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 1
            }
          ]
        }
      },
      "position": [
        0,
        400
      ],
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2
    },
    {
      "id": "manual-run",
      "name": "Manual run",
      "parameters": {},
      "position": [
        0,
        600
      ],
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1
    },
    {
      "credentials": {
        "httpHeaderAuth": {
          "name": "AP core token"
        }
      },
      "executeOnce": true,
      "id": "quickbooks-target-core",
      "maxTries": 3,
      "name": "QuickBooks target (core)",
      "onError": "continueRegularOutput",
      "parameters": {
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "method": "GET",
        "options": {
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          }
        },
        "url": "http://core:8000/accounting/target"
      },
      "position": [
        240,
        400
      ],
      "retryOnFail": true,
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "waitBetweenTries": 2000
    },
    {
      "credentials": {
        "quickBooksOAuth2Api": {
          "name": "QuickBooks – Sandbox US"
        }
      },
      "id": "accounts-qbo",
      "maxTries": 3,
      "name": "Accounts (QBO)",
      "onError": "continueRegularOutput",
      "parameters": {
        "authentication": "predefinedCredentialType",
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/json"
            }
          ]
        },
        "method": "GET",
        "nodeCredentialType": "quickBooksOAuth2Api",
        "options": {
          "batching": {
            "batch": {
              "batchInterval": 300,
              "batchSize": 1
            }
          },
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          }
        },
        "queryParameters": {
          "parameters": [
            {
              "name": "minorversion",
              "value": "={{ $('QuickBooks target (core)').first().json.body.minorversion }}"
            },
            {
              "name": "query",
              "value": "select * from Account maxresults 1000"
            }
          ]
        },
        "sendHeaders": true,
        "sendQuery": true,
        "url": "={{ $('QuickBooks target (core)').first().json.body.qbo_base }}/query"
      },
      "position": [
        480,
        400
      ],
      "retryOnFail": true,
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "waitBetweenTries": 2000
