# Public HTTPS front door. Host names and the Let's Encrypt account e-mail come from .env
# (docker-compose.prod.yml).
#
# The home page (davidmichel.dev) is static files from a read-only mount. The demo pages are the
# only service forwarded (demo-web, on Caddy's network). No n8n route is served: n8n's editor, sign-in and OAuth callback are reached through an SSH
# tunnel (docs/deployment.md), and so is the review page's internal listener (docs/security.md).
# A public n8n webhook, if one is ever needed, gets a host of its own that forwards only exact
# POST paths; scripts/check_deploy_config.sh refuses any proxy route without a path matcher.
{
	email {$ACME_EMAIL}
	admin off
}

(hardening) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		X-Frame-Options "DENY"
		-Server
	}
}

# The home page: static files from the site repository (github.com/dmichel-dev/davidmichel.dev),
# mounted read-only. It has no scripts and loads nothing from elsewhere, so the policy allows only its
# own stylesheet, fonts and images. A missing file is an empty 404.
{$HOME_HOST} {
	import hardening
	header Content-Security-Policy "default-src 'none'; style-src 'self'; font-src 'self'; img-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
	encode zstd gzip
	root * /srv/site
	file_server
}

# The www name redirects permanently to the home page, keeping the path.
www.{$HOME_HOST} {
	import hardening
	redir https://{$HOME_HOST}{uri} permanent
}

# The public demo pages (demo-web). Only their own paths are forwarded; anything else, the
# container's /health included, is an empty 404. Bodies are capped just above the demo's 5 MB file
# limit (demo-web refuses a larger one too, before reading it).
{$DEMO_HOST} {
	import hardening
	request_body {
		max_size 6MB
	}
	@demo path / /start /privacy /credits /s/* /static/*
	handle @demo {
		reverse_proxy demo-web:8082
	}
	handle {
		respond 404
	}
}

# Names that no longer serve anything (e.g. a former public name of the n8n editor): an empty
# 404 on every path, until the DNS record is removed.
{$RETIRED_HOSTS} {
	import hardening
	respond 404
}
